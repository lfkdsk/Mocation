{
  "name": "mocation-web",
  "version": "0.1.0",
  "private": true,
  "description": "Mocation 取景地 — unofficial web client (film filming-location explorer)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "scrape:enum": "node scripts/scrape/enumerate.mjs",
    "scrape:details": "node scripts/scrape/details.mjs",
    "scrape:snapshot": "node scripts/scrape/snapshot.mjs",
    "scrape:restore": "node scripts/scrape/snapshot.mjs --restore",
    "pages:build": "npx @cloudflare/next-on-pages@1",
    "preview:cf": "npm run pages:build && wrangler pages dev .vercel/output/static",
    "deploy:cf": "npm run pages:build && wrangler pages deploy .vercel/output/static"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "15.1.11",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.7",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.0.0",
    "typescript": "^5",
    "wrangler": "^3.90.0"
  }
}
